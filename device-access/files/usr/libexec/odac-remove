#!/bin/sh
# Package removal deliberately retains a durable controlled-network deny rule.
set -eu
[ "${1:-}" = --retain-guard ] || { echo 'Usage: odac-remove --retain-guard' >&2; exit 2; }
iface=$(uci -q get odac.main.interface || true)
[ -n "$iface" ] || exit 0
# A never-configured, disabled installation owns no services or firewall state.
if [ "$(uci -q get odac.main.enabled || echo 0)" != 1 ] && [ ! -f /etc/odac/last-setup ]; then
 nft list table inet odac_guard >/dev/null 2>&1 || exit 0
fi
case "$iface" in *[!a-zA-Z0-9_.:-]*) echo 'Invalid controlled interface' >&2; exit 1;; esac
# Save pre-removal state independently of setup history, including on upgrades.
umask 077
mkdir -p /etc/odac
removal_backup=$(mktemp -d /etc/odac/removal-XXXXXXXX)
for file in odac opennds uhttpd firewall; do cp -p "/etc/config/$file" "$removal_backup/$file"; done
/etc/init.d/opennds enabled && echo 1 > "$removal_backup/opennds-enabled" || echo 0 > "$removal_backup/opennds-enabled"
# Even if service stop fails, never proceed with an unguarded uninstall.
/usr/libexec/odac-firewall close "$iface"
/etc/init.d/odac stop
/etc/init.d/opennds stop
/etc/init.d/opennds disable
/etc/init.d/odac disable
mkdir -p /etc/nftables.d /etc/odac
umask 077
# This snippet is INSIDE table inet fw4 and needs no removed ODAC binary.
# Preserve it and /etc/odac during apk removal; it is operator-owned recovery data.
printf 'chain odac_retired_forward { type filter hook forward priority -10; policy accept; iifname "%s" drop; oifname "%s" drop; }\nchain odac_retired_input { type filter hook input priority -10; policy accept; iifname "%s" drop; }\n' "$iface" "$iface" "$iface" > /etc/nftables.d/90-odac-retired.nft.new
mv /etc/nftables.d/90-odac-retired.nft.new /etc/nftables.d/90-odac-retired.nft
uci -q delete firewall.odac_guard || true
for section in dns dhcp http https nds; do uci -q delete firewall.odac_$section || true; done
uci commit firewall
uci set odac.main.enabled=0
uci commit odac
fw4 check
fw4 reload
# Runtime leases/table remain denied. Data and backups are intentionally retained.
echo 'ODAC stopped. Controlled network remains DROP; user database and backups retained.' >&2
