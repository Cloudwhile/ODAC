#!/bin/sh /etc/rc.common
START=98
STOP=10
USE_PROCD=1
start_service() {
 [ "$(uci -q get odac.main.enabled)" = 1 ] || return 0
 /usr/libexec/odac-preflight || return 1
 /usr/libexec/odac-config || return 1
 local iface gateway http https cert key
 iface=$(uci -q get odac.main.interface)
 gateway=$(uci -q get odac.main.gateway)
 http=$(uci -q get odac.main.portal_port)
 https=$(uci -q get odac.main.portal_https_port)
 cert=$(uci -q get odac.main.tls_cert)
 key=$(uci -q get odac.main.tls_key)
 # shellcheck disable=SC2046 # one argument per configured upstream address
 /usr/libexec/odac-firewall init "$iface" "$gateway" "$http" "$https" $(uci -q get odac.main.upstream || true) || return 1
 /etc/init.d/opennds start || return 1
 procd_open_instance daemon
 procd_set_param command /usr/sbin/odacd --config /var/run/odac/config.json
 procd_set_param respawn 3600 5 5
 procd_set_param stderr 1
 procd_set_param limits core=0
 procd_close_instance
 procd_open_instance landing
 procd_set_param command /usr/sbin/uhttpd -f -c /etc/odac/httpd.conf -D -h /www/odac-landing -p "$gateway:$http" -x /cgi-bin -E /cgi-bin/landing -t 15 -T 20 -n 4 -N 32
 procd_set_param respawn 3600 5 5
 procd_set_param stderr 1
 procd_set_param limits core=0
 procd_close_instance
 procd_open_instance portal
 procd_set_param command /usr/sbin/uhttpd -f -c /etc/odac/httpd.conf -D -S -h /www/odac -s "$gateway:$https" -C "$cert" -K "$key" -x /cgi-bin -t 15 -T 20 -n 4 -N 32
 procd_set_param respawn 3600 5 5
 procd_set_param stderr 1
 procd_set_param limits core=0
 procd_close_instance
}
stop_service() {
 local iface
 iface=$(uci -q get odac.main.interface)
 [ -z "$iface" ] || /usr/libexec/odac-firewall close "$iface"
}
reload_service() {
 stop
 start
}
