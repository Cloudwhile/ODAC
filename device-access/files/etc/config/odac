config odac 'main'
 option enabled '0'
 option network 'odac'
 option interface 'br-odac'
 option zone 'odac'
 option gateway '192.168.30.1'
 option portal_port '2080'
 option portal_https_port '8443'
 option portal_hostname ''
 option tls_cert ''
 option tls_key ''
 option database '/etc/odac/odac.db'
 option socket_path '/var/run/odac/control.sock'
 option upstream ''
 option status_file '/var/run/odac/upstream.status'
 option pid_file ''
 option session_seconds '3600'
 option max_users '200'
 option max_devices '500'
 option max_sessions '64'
 option upload_kbps '0'
 option download_kbps '0'
 option wan_interval '30'
 option max_audit '1000'
 option db_max_kib '2048'
